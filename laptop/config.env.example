# laptop/config.env.example — REPO documents the keys tools/tv.py and
# laptop/setup/*.sh read. LAPTOP copies this to laptop/config.env (LAPTOP's
# file; REPO never edits it) and fills in the laptop-specific values.
# Format: KEY=VALUE, shell-style; ~ and $VARS are expanded; "#" starts a comment.

# ---- Apple TV ---------------------------------------------------------------
TV_IP=192.168.1.50                 # LAN IP of the Apple TV (debug server at TV_IP:TV_PORT)
TV_PORT=7777
TV_DEVICE_ID=                      # pyatv identifier from `atvremote scan` (MAC or UUID)
TV_UDID=                           # device UDID (for JIT / pymobiledevice3 style tools), optional
TVOS_VERSION=                      # e.g. 18.5 — never update tvOS
ATVREMOTE=atvremote                # pyatv CLI; pair once with `atvremote wizard` so credentials persist
ATVREMOTE_ARGS=                    # extra args, e.g. "--companion-credentials <hex>" if not stored

# ---- App --------------------------------------------------------------------
APP_BUNDLE_ID=dev.rltvos.app       # as built; free-account signers append the team id, tv.py resolves it via app_list

# ---- Install (atvloadly) ----------------------------------------------------
# Precedence in tv.py install: INSTALL_CMD > ATVLOADLY_MCP_INSTALL_TOOL > HTTP multipart guess.
# Placeholders everywhere: {ipa} {tag} {tv_ip} {device_id} {udid} {bundle_id}
# {bundle_prefix} {apple_id} {repo_root}.
INSTALL_CMD=                       # e.g. "python3 ~/atvloadly-install.py --udid {udid} --ipa {ipa}"
INSTALL_TIMEOUT=900
# atvloadly MCP (streamable HTTP). Discover tools with: tools/tv.py mcp list
ATVLOADLY_MCP_URL=http://127.0.0.1:5533/mcp
ATVLOADLY_MCP_INSTALL_TOOL=        # tool name that installs an IPA, e.g. install_ipa
ATVLOADLY_MCP_INSTALL_ARGS={}      # JSON args template, e.g. {"udid":"{udid}","ipa_path":"{ipa}"}
# HTTP fallback (multipart POST of the IPA) when neither of the above is set.
ATVLOADLY_URL=http://127.0.0.1:8080
ATVLOADLY_INSTALL_URL=             # full URL if not ATVLOADLY_URL/api/install
ATVLOADLY_FORM={}                  # JSON of extra form fields, e.g. {"udid":"{udid}","account":"{apple_id}"}
ATVLOADLY_FILE_FIELD=file
APPLE_ID=                          # free Apple ID used by atvloadly (password stays in atvloadly)

# ---- JIT --------------------------------------------------------------------
# tvOS 26+/TXM (A15+): executable memory must be *prepared through a debug
# connection* (StikDebug "universal" protocol). The app (jit26.c) waits up to
# RLJitWaitS for P_TRACED, then calls its `brk #0xf00d` stubs: JIT26PrepareRegion
# (the helper allocates an RX region, `_M<len>,rx`, and writes one byte per
# 16 KB page) and JIT26Detach. The app vm_remaps an RW alias, self-tests, and
# reports /status.jit {stage, pool, rw_alias, prepared_by, attached_test,
# detached_test}. `tv.py jit` runs JIT_CMD (LAPTOP's laptop/jit.sh) and polls
# /status.jit until stage=ready. Must be redone after every launch.
# Runtime knobs live in the app (tv.py jitcfg jit_pool_mb=128 jit_wait_s=60
# jit_in_place=0 jit_detach=1 jit_selftest=1 jit_autostart=1).
JIT_BACKEND=auto                   # auto|cmd|mcp|gdbremote  (auto: cmd if JIT_CMD, mcp if MCP tool, else gdbremote=legacy)
JIT_CMD=                           # LAPTOP's helper, e.g. "laptop/jit.sh --launch {bundle_id}" or "laptop/jit.sh --pid {pid}"
JIT_DDI_DIR=                       # tvOS 27+: the Cryptex1 developer disk image dir (Xcode 27's tvOS_DDI, published layout) that jit.sh installs via cryptexd when the debug services are missing
JIT_LAUNCHES_APP=0                 # 1 if JIT_CMD launches the app itself (--launch): tv.py cycle/jit skip the launch
JIT_CMD_BACKGROUND=0               # 1 if JIT_CMD keeps running while servicing requests (tv.py starts it and polls the app)
JIT_READY_TIMEOUT=120              # seconds tv.py waits for /status.jit.stage == ready after JIT_CMD
JIT_TIMEOUT=300                    # timeout for a foreground JIT_CMD
# legacy gdbremote backend (page-touch authorization of the RWX arena; not the plan on TXM boxes):
DEBUGSERVER_ADDR=                  # host:port of a running debugserver / proxy, e.g. 127.0.0.1:2345 or [fd12::1%utun3]:49152
DEBUGSERVER_CMD=                   # or: command that starts one and prints its address, e.g.
                                   #   "pymobiledevice3 developer debugserver start-server --userspace --udid {udid}"
DEBUGSERVER_ADDR_REGEX=            # override the host:port scraper (default matches connect://[host]:port or 'listening ... PORT')
DEBUGSERVER_HOST=127.0.0.1         # host used when only a port is printed
DEBUGSERVER_START_TIMEOUT=90
DEBUGSERVER_TIMEOUT=60
DEBUGSERVER_KEEP=0                 # 1 = leave DEBUGSERVER_CMD running after authorization
JIT_AUTH_CHUNK=32768               # bytes per read/write packet (bounded by debugserver PacketSize)
JIT_AUTH_MB=0                      # authorize only the first N MB of the arena (0 = all)
JIT_KEEP_ATTACHED=0                # 1 = do not detach after authorizing (experiment)
# mcp backend (an atvloadly tool that attaches the debugger helper)
ATVLOADLY_MCP_JIT_TOOL=            # e.g. enable_jit
ATVLOADLY_MCP_JIT_ARGS={}          # e.g. {"udid":"{udid}","bundle_id":"{bundle_id}"}
JIT_SETTLE_S=1

# ---- Optional overrides -----------------------------------------------------
LAUNCH_CMD=                        # default: atvremote --id TV_DEVICE_ID launch_app={bundle_id}
KILL_CMD=                          # default: POST /kill

# ---- GitHub releases --------------------------------------------------------
GITHUB_REPO=user99672223/RLtvOS
GITHUB_TOKEN=                      # only needed if the repo is private
IPA_DIR=~/rltvos/ipa
OUT_DIR=~/rltvos/out               # screenshots, logs, state.json

# ---- Guest assets (laptop/setup/*.sh, laptop/assets_server.py) ---------------
LAPTOP_IP=192.168.1.20             # IP the Apple TV uses to reach the laptop
ASSETS_PORT=8090
ASSETS_DIR=~/rltvos/assets         # rootfs/, prefix/, game/ live (or are linked) under here
ROOTFS_DIR=~/rltvos/assets/rootfs  # Debian amd64 rootfs (debootstrap)
WINEPREFIX_DIR=~/rltvos/assets/prefix
GAME_DIR=                          # Rocket League install dir (Heroic/Legendary); empty = auto-detect via `legendary list-installed`
REFS_DIR=~/rltvos/refs             # strace reference traces
DEBIAN_SUITE=bookworm
DEBIAN_MIRROR=http://deb.debian.org/debian
WINE_BRANCH=stable                 # WineHQ branch: stable|devel|staging
DXVK_MACOS_VERSION=                # Gcenx dxvk-macOS release tag; empty = latest
