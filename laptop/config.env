# laptop/config.env — LAPTOP owns this file; REPO reads it, never edits it.
# Keys documented in laptop/config.env.example. Must parse both as POSIX sh
# (laptop/setup/lib.sh sources it) and in tools/tv.py: quote values that
# contain spaces and put no comment after a quoted value.
# The repo is PUBLIC: no secrets, tokens, Apple ID or pairing data in here.

# ---- Apple TV ---------------------------------------------------------------
TV_IP=192.168.1.7
TV_PORT=7777
TV_DEVICE_ID=82:FD:10:E7:9B:61     # pyatv id; Companion + AirPlay paired, creds in ~/.pyatv.conf
TV_UDID=00008110-000A118821E1801E
ATV_ID=00008110-000A118821E1801E   # brief's name for the device id (= TV_UDID)
TV_MODEL="AppleTV14,1 J255AP MN873"
TVOS_VERSION=27.0                  # build 24J361, Developer Mode on — never update tvOS
TVOS_BUILD=24J361
TV_STORAGE_GB=128                  # MN873 = 128 GB Wi-Fi+Ethernet model
ATVREMOTE=$HOME/.venvs/rltvos/bin/atvremote
ATVREMOTE_ARGS=

# ---- App --------------------------------------------------------------------
APP_BUNDLE_ID=dev.rltvos.app       # atvloadly installs it as <id>.GBCWA7VWJ3 (team id suffix); tv.py matches the prefix

# ---- Install (atvloadly v0.4.8, docker, ~/docker-compose.yml) ---------------
ATVLOADLY_HOST_PORT=192.168.1.133:5533
ATVLOADLY_URL=http://127.0.0.1:5533
ATVLOADLY_MCP=http://127.0.0.1:5533/mcp
ATVLOADLY_MCP_URL=http://127.0.0.1:5533/mcp
# INSTALL_CMD takes precedence over the MCP install tool in tv.py.
ATVLOADLY_MCP_INSTALL_TOOL=
ATVLOADLY_MCP_INSTALL_ARGS={}
ATVLOADLY_DEVICE_ID=a133f02dcb24581f4b3f98e63c61a52a
ATVLOADLY_SHARE_CONTAINER=/share/ipa  # IPA_DIR is bind-mounted read-only here in the container
INSTALL_CMD="$HOME/local_RLtvOS/laptop/install.sh {ipa}"
INSTALL_TIMEOUT=900
# APPLE_ID intentionally empty: atvloadly holds the (single) account.
APPLE_ID=

# ---- JIT --------------------------------------------------------------------
# tvOS 27 / A15 (TXM): StikDebug universal.js protocol (handoff/issues/001-jit.md, 003-…).
# cmd backend: laptop/jit.sh (Rust helper laptop/jit/, rootless RemotePairing tunnel) attaches
# to the running app (it waits for a debugger), services brk #0xf00d PrepareRegion/Detach.
# Not yet tried on the TV (user HOLD). gdbremote keys below are unused.
JIT_BACKEND=cmd
TV_RP_PORT=49152
DEBUGSERVER_ADDR=
DEBUGSERVER_CMD=
DEBUGSERVER_ADDR_REGEX=
DEBUGSERVER_HOST=127.0.0.1
DEBUGSERVER_START_TIMEOUT=90
DEBUGSERVER_TIMEOUT=60
DEBUGSERVER_KEEP=0
JIT_AUTH_CHUNK=32768
JIT_AUTH_MB=0
JIT_KEEP_ATTACHED=0
JIT_CMD="$HOME/local_RLtvOS/laptop/jit.sh --pid {pid}"
ATVLOADLY_MCP_JIT_TOOL=
ATVLOADLY_MCP_JIT_ARGS={}
JIT_TIMEOUT=300
JIT_SETTLE_S=1
JIT_LAUNCHES_APP=0
# ---- GitHub releases --------------------------------------------------------
GITHUB_REPO=user99672223/RLtvOS
GITHUB_TOKEN=
IPA_DIR=$HOME/rltvos/ipa
OUT_DIR=$HOME/rltvos/out

# ---- Guest assets -------------------------------------------------------------
LAPTOP_IP=192.168.1.133            # Wi-Fi (wlp0s20f3)
ASSETS_PORT=8090
ASSETS_DIR=$HOME/rltvos/assets
ROOTFS_DIR=$HOME/rltvos/assets/rootfs
WINEPREFIX_DIR=$HOME/rltvos/assets/prefix
HOME_DIR=$HOME/rltvos/assets/home
GAME_DIR=$HOME/Games/Heroic/rocketleague   # Legendary app Sugar, ++Prime+Update60-CL-528314
REFS_DIR=$HOME/local_RLtvOS/refs
DEBIAN_SUITE=trixie
DEBIAN_MIRROR=http://deb.debian.org/debian
WINE_BRANCH=stable
DXVK_MACOS_VERSION=v1.10.3-20230507-repack
